generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MENTOR
  MENTEE
}

enum FormStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum IssueStatus {
  OPEN
  CLOSED
}

enum IssueType {
  ACADEMIC
  PERSONAL
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  username      String   @unique
  password      String
  role          Role
  isFirstLogin  Boolean  @default(true)
  isActive      Boolean  @default(true)
  academic_year String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mentor Mentor?
  mentee Mentee?
}

model Mentor {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  email         String @unique
  department    String
  academic_year String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentees   Mentee[]
  meetings  MeetingReport[]
  issues    IssueLog[]
  messages  GuidanceMessage[]
  schedules MeetingSchedule[]
}

model Mentee {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  prn           String  @unique
  name          String
  email         String? @unique
  academic_year String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorId String? @db.Uuid
  mentor   Mentor? @relation(fields: [mentorId], references: [id])

  mentorshipForm  MentorshipForm?
  progressRecords ProgressRecord[]
  issues          IssueLog[]
  messages        GuidanceMessage[]
  notifications   Notification[]
  achievements    Achievement[]
}

model MentorshipForm {
  id       String @id @default(uuid()) @db.Uuid
  menteeId String @unique @db.Uuid
  mentee   Mentee @relation(fields: [menteeId], references: [id], onDelete: Cascade)

  status        FormStatus @default(PENDING)
  academic_year String

  // JSON field storing structural form data (PersonalInfo, AcademicHistory, Parents, Medical, Photo URL)
  formData Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MeetingReport {
  id              String   @id @default(uuid()) @db.Uuid
  meetingNumber   Int
  date            DateTime
  location        String
  class           String
  semester        String
  academic_year   String
  agenda          String
  discussion      String
  suggestions     String
  conclusion      String
  attendanceCount Int

  mentorId String @db.Uuid
  mentor   Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IssueLog {
  id            String      @id @default(uuid()) @db.Uuid
  date          DateTime
  academic_year String
  issueType     IssueType
  description   String
  actionTaken   String
  referredTo    String?
  followUpDate  DateTime?
  status        IssueStatus @default(OPEN)

  mentorId String @db.Uuid
  mentor   Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  menteeId String @db.Uuid
  mentee   Mentee @relation(fields: [menteeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProgressRecord {
  id                  String @id @default(uuid()) @db.Uuid
  semester            String
  academic_year       String
  cgpa                Float
  attendance          Float
  backlogs            Int
  technicalSkills     String
  communicationSkills String
  activities          String
  certifications      String
  internships         String
  projects            String
  selfRating          Int

  autoScore Float? // Calculated: CGPA 40% + Attendance 30% + Skills 30%

  menteeId String @db.Uuid
  mentee   Mentee @relation(fields: [menteeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuidanceMessage {
  id            String  @id @default(uuid()) @db.Uuid
  content       String
  academic_year String
  isFromMentor  Boolean @default(true)

  mentorId String @db.Uuid
  mentor   Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  menteeId String @db.Uuid
  mentee   Mentee @relation(fields: [menteeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model MeetingSchedule {
  id            String   @id @default(uuid()) @db.Uuid
  title         String
  date          DateTime
  location      String
  academic_year String
  isBatch       Boolean  @default(true)

  mentorId String @db.Uuid
  mentor   Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id            String  @id @default(uuid()) @db.Uuid
  title         String
  message       String
  isRead        Boolean @default(false)
  academic_year String

  menteeId String @db.Uuid
  mentee   Mentee @relation(fields: [menteeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum AchievementType {
  HACKATHON
  INTERNSHIP
  PROJECT
  COMPETITION
}

model Achievement {
  id              String          @id @default(uuid()) @db.Uuid
  type            AchievementType
  title           String
  description     String
  link            String?
  certificate_url String?
  academic_year   String

  menteeId String @db.Uuid
  mentee   Mentee @relation(fields: [menteeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
